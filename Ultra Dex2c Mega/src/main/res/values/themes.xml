<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UltraDex2CVMP" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="switchStyle">@style/SwitchStyle</item>
    </style>

    <style name="SwitchStyle" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorControlActivated">@color/accent_green</item>
    </style>

    <style name="Theme.UltraDex2CVMP.Splash" parent="Theme.UltraDex2CVMP">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="CardStyle" parent="">
        <item name="android:background">@drawable/bg_card_border</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="BottomSheetTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="shapeAppearance">@style/BottomSheetShape</item>
    </style>

    <style name="BottomSheetShape" parent="ShapeAppearance.MaterialComponents">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
    </style>

    <style name="UpdateDialogStyle" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/UpdateDialogAnim</item>
    </style>

    <style name="UpdateDialogAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_update_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_update_exit</item>
    </style>
</resources>
