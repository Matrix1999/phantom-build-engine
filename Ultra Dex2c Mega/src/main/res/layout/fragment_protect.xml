<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- ── Top bar: APK selector (always visible) ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/bar_apk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/nav_bg"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <!-- Animated shield icon (small) -->
        <com.ultra.dex2cvmp.ui.ShieldAnimView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_apk_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No APK selected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tv_apk_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap Browse to open an APK"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- Reset button — clears selection and returns to empty state -->
        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:text="↺"
            android:textSize="20sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:background="@drawable/bg_card_border"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Compiler status banner ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/banner_compiler"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1500FF00"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tv_compiler_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:text="⬤"
            android:textSize="8sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_compiler_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Checking compiler…"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btn_compiler_setup"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="⚙ Compiler"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_card_border"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── Empty state (no APK loaded) ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/state_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <com.ultra.dex2cvmp.ui.ShieldAnimView
            android:layout_width="180dp"
            android:layout_height="180dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Open an APK to begin"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Browse for an APK file and Ultra Dex2C-VMP will instantly show you its packages, classes and methods — tap what you want to protect."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Browse button -->
        <LinearLayout
            android:id="@+id/btn_pick_apk"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_btn_green"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse APK"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Loading state ──────────────────────────────────────────────────────  -->
    <LinearLayout
        android:id="@+id/state_loading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_green" />

        <TextView
            android:id="@+id/tv_loading_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Parsing APK structure..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ── Tree + actions (shown after APK loaded) ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/state_tree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ── Mode toggle bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_card2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Manual tab -->
            <LinearLayout
                android:id="@+id/tab_manual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_btn_green"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_tab_manual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛶  Manual"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Class List tab -->
            <LinearLayout
                android:id="@+id/tab_class_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_border"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_tab_class_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰  Class List"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── PANEL A: Manual tree (default) ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/panel_manual"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Search bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌕"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search package or class..."
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />

                    <TextView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:paddingStart="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Selection toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:background="@color/bg_card2">

                <TextView
                    android:id="@+id/tv_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 classes selected"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/btn_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />

                <TextView
                    android:id="@+id/btn_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Tree RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tree"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/bg_dark"
                android:clipToPadding="false"
                android:paddingBottom="120dp"
                android:overScrollMode="never" />

        </LinearLayout>

        <!-- ── PANEL B: Class List paste (hidden by default) ──────────────── -->
        <LinearLayout
            android:id="@+id/panel_class_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_card2"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tv_class_list_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 classes"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/btn_paste_classes"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="⎗ Paste"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_card_border"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_clear_class_list"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="✕ Clear"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_card_border"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Paste area -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/bg_dark"
                android:overScrollMode="never"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/et_class_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="300dp"
                    android:background="@null"
                    android:padding="14dp"
                    android:hint="Paste class names here, one per line&#10;&#10;com.example.app.MainActivity&#10;com.example.app.TokenInterceptor&#10;com.example.app.HardwareAttest"
                    android:textColorHint="@color/text_muted"
                    android:textColor="#80FFD4"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:gravity="top|start"
                    android:lineSpacingExtra="4dp"
                    android:scrollbars="none" />

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Progress state (during protection run) ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/state_progress"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Stage + Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_card2"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_stage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Initializing..."
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressTint="@color/accent_green"
            android:progressBackgroundTint="@color/bg_card2" />

        <!-- Console log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONSOLE"
                style="@style/SectionLabel"
                android:layout_marginBottom="0dp" />

            <TextView
                android:id="@+id/btn_copy_log"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⎘ Copy"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_card_border"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_console"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_dark"
            android:overScrollMode="never"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tv_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text=""
                android:textColor="#80FFD4"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

    </LinearLayout>

    <!-- ── Bottom action bar (fixed at bottom) ──────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nav_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Options row: sign toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-Sign APK"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <!-- Options row: VMP toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mode_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dex2C Mode"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_mode_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bytecode stripped and rebuilt as hardened C++ native"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_vmp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- Run / Cancel buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_card_border"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="@color/danger"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_protect"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:gravity="center"
                android:background="@drawable/bg_btn_green"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/btn_protect_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Run Protection"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
