<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_border"
        android:padding="22dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OLLVM ENGINE"
                android:textColor="@color/accent_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/btn_close_dialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is OLLVM?"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OLLVM patches Clang/LLVM to apply obfuscation at the IR level before any machine code is emitted. Every level uses all 8 techniques — what changes is the intensity: how aggressively each pass rewrites the IR."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All levels: FLA · BCF · SUB · SOBF · SPLIT · IBR · ICALL · IGV"
            android:textColor="@color/accent_green_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Level rows -->

        <!-- 0 — Phantom Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_phantom"
                android:contentDescription="Phantom Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PHANTOM LEVEL  ·  bcf_prob=100  loop=4  split=5"
                    android:textColor="#FF1744" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Absolute maximum. BCF fires on 100% of blocks, repeated 4 times. IR graph becomes enormous. Near-impenetrable for any static tool. Expect ~10-15× compile time."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1 — Ultimate Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_ultimate"
                android:contentDescription="Ultimate Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ULTIMATE LEVEL  ·  bcf_prob=90  loop=3  split=4"
                    android:textColor="#FF6D00" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Near-peak intensity. Defeats most automated decompiler analysis. Ghidra fails to recover jump tables. Expect ~7-10× compile time."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2 — Supreme Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_supreme"
                android:contentDescription="Supreme Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SUPREME LEVEL  ·  bcf_prob=80  loop=3  split=4"
                    android:textColor="#FFAB00" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Extreme intensity with slightly reduced BCF probability. Heavy protection, more manageable build overhead than Ultimate."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 — Advanced Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_advanced"
                android:contentDescription="Advanced Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ADVANCED LEVEL  ·  bcf_prob=70  loop=2  split=3"
                    android:textColor="#C6FF00" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Heavy intensity — these are the exact parameters the original compiler used by default. Strong protection, proven stable across most devices."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4 — Turbo -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_turbo"
                android:contentDescription="Turbo Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TURBO LEVEL  ·  bcf_prob=60  loop=2  split=3"
                    android:textColor="#00E676" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Balanced. Solid protection with noticeably faster builds than Advanced Level. Best choice for daily production releases."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5 — Ultra Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_ultra"
                android:contentDescription="Ultra Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ULTRA LEVEL  ·  bcf_prob=50  loop=2  split=2"
                    android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Moderate intensity. BCF fires on half of blocks. All techniques active, IR graph stays smaller — builds finish notably faster."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 6 — Prime Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_prime"
                android:contentDescription="Prime Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PRIME LEVEL  ·  bcf_prob=40  loop=1  split=2"
                    android:textColor="#2979FF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Standard intensity. Each pass runs once with reduced scope. Meaningful hardening at near-comfortable build times. Good compatibility across devices."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 7 — Nova Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_bull"
                android:contentDescription="Nova Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOVA LEVEL  ·  bcf_prob=30  loop=1  split=1"
                    android:textColor="#D500F9" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Minimal intensity. All 8 techniques fire lightly — BCF touches 30% of blocks once. Very fast builds. Use this if a heavier level causes crashes on specific devices."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 8 — Lite Level -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="18dp"
            android:gravity="top">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_ollvm_lite"
                android:contentDescription="Lite Level"
                android:layout_marginEnd="10dp" android:layout_marginTop="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LITE LEVEL  ·  bcf_prob=20  loop=1  split=1"
                    android:textColor="#78909C" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Baseline intensity. The gentlest possible application of all 8 passes. Near-native build speed. Obfuscation is present but light — mostly useful for diagnosing compatibility issues."
                    android:textColor="@color/text_muted" android:textSize="11sp"
                    android:lineSpacingExtra="2dp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Higher levels mean longer compile times — a large APK at Phantom or Ultimate can take significantly longer. If you need faster results, use a lower level like Turbo or Ultra. If you have no patience to wait, toggle OLLVM off for instant normal compilation. Work your way up to find the level that fits your speed."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
