<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ── Hero animation ─────────────────────────────────────────────── -->
        <com.ultra.dex2cvmp.ui.ShieldAnimView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="4dp" />

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultra Dex2C-VMP"
            android:textColor="@color/accent_green"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2-in-1 Native APK Protection Engine"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.0  ·  On-Device  ·  ARM64 + ARM32  ·  Offline"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- ── CHOOSE YOUR MODE ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE YOUR MODE"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ultra Dex2C-VMP has two completely different protection engines. You pick which one to use before each protection job — they can even be used together on different classes of the same APK."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginBottom="18dp" />

                <!-- Dex2C card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEX2C"
                            android:textColor="@color/bg_dark"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:background="@color/accent_green"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default mode  ·  VMP toggle OFF"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Java/Kotlin method bodies are transpiled 1-to-1 into C++ and compiled with OLLVM clang. Decompilers return empty stubs — the logic lives in native ARM64 machine code with up to 8 layers of IR obfuscation."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Pros / Cons row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Fast protection job"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Near-zero runtime overhead"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Protects large class counts easily"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- VMP card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VMP"
                            android:textColor="@color/bg_dark"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:background="@color/accent_green"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginEnd="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Virtual Machine  ·  VMP toggle ON"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Method bytecode is converted to a custom randomised instruction set (different every run) and executed by a private C VM interpreter baked into the .so. Decompilers and disassemblers see unknown opcodes they cannot decode — there is no standard format to reverse-engineer."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Pros / Cons row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Strongest protection available"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Opcode map re-randomised every run"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  No known decompiler can decode it"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Deep VM compilation for maximum security"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  Runtime execution fully hidden inside VM"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── WHERE TO TOGGLE VMP ────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOW TO SWITCH MODES"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Step: open protect -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="1"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_green"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open the Protect tab and browse for your APK"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Step: find VMP toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="2"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_green"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Find the VMP Mode toggle on the Protect screen"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />
                        <!-- inline toggle preview -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_card_border"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="VMP Mode"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Virtual Machine Protection"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="◀ toggle here"
                                android:textColor="@color/accent_green"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Step: toggle off = dex2c -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="3"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_green"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="1dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OFF"
                                android:textColor="@color/bg_dark"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:background="@color/text_muted"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dex2C mode — fast native compilation"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Methods are transpiled directly to C++ and compiled with OLLVM. Fast job, near-zero runtime cost. Good for large numbers of classes."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Step: toggle on = VMP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="4"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_green"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="1dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ON"
                                android:textColor="@color/bg_dark"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:background="@color/accent_green"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VMP mode — maximum protection"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bytecode is converted to a randomised custom opcode set and executed inside a private VM baked into the .so. The opcode map is re-randomised every run — no two protected APKs are the same and no known tool can reverse-engineer the output."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Step-by-step guide ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP-BY-STEP"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Step 1 — One-time setup -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp"
                    android:text="1"
                    android:textColor="@color/bg_dark" android:textSize="13sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_btn_green"
                    android:layout_marginEnd="14dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Download the NDK compiler once"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Python 3 is bundled inside the app and extracts silently on first run — nothing to do. The OLLVM NDK compiler (731 MB) requires a one-time download: tap ⚙ Compiler on the Protect screen, then tap Download NDK. Once installed it stays in internal storage and is reused for every job."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="10dp" />
                    <!-- Offline badge -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_card_border"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_lock"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="After the one-time NDK download, everything is fully offline — transpiling, OLLVM compilation, VM building, bytecode stripping, and signing all run on-device."
                            android:textColor="@color/accent_green" android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp"
                    android:text="2"
                    android:textColor="@color/bg_dark" android:textSize="13sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_btn_green"
                    android:layout_marginEnd="14dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Browse for your APK"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Open the Protect tab and tap Browse. Pick any APK from your storage."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp"
                    android:text="3"
                    android:textColor="@color/bg_dark" android:textSize="13sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_btn_green"
                    android:layout_marginEnd="14dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Choose your mode, then pick targets"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Toggle VMP Mode ON or OFF (see above). Then select which classes or methods to protect — MANUAL tab lets you browse the class tree and tick boxes, CLASS LIST tab lets you paste fully-qualified class names one per line."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step 4 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp"
                    android:text="4"
                    android:textColor="@color/bg_dark" android:textSize="13sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_btn_green"
                    android:layout_marginEnd="14dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Run Protection"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tap Run Protection. In Dex2C mode: methods are transpiled to C++ and compiled with OLLVM. In VMP mode: bytecode is re-encoded with a randomised opcode map and a custom VM is built and linked into the .so. Either way, original bytecode is stripped and the APK is re-signed — all on-device."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Step 5 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="top">
                <TextView android:layout_width="28dp" android:layout_height="28dp"
                    android:text="5"
                    android:textColor="@color/bg_dark" android:textSize="13sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_btn_green"
                    android:layout_marginEnd="14dp" android:layout_marginTop="2dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Install the protected APK"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="The protected APK is saved to /storage/emulated/0/Ultra Dex2C-VMP. Install it normally — it behaves identically to the original, but its logic is locked in native code or running inside the private VM."
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Signature Check ─────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIGNATURE CHECK"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Row: Pre-signed input -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_sig_signed"
                        android:layout_marginEnd="10dp" android:layout_marginTop="2dp"
                        android:contentDescription="Signed" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Input APK is already signed (recommended)"
                            android:textColor="@color/text_primary" android:textSize="13sp"
                            android:textStyle="bold" android:layout_marginBottom="3dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ultra Dex2C-VMP automatically reads the cert from your input APK and stamps its SHA-256 into the protected .so. Toggle Auto-Sign OFF so the output stays unsigned. Re-sign the protected APK with your own key as usual — the cert check will pass at runtime. Your update chain is never broken."
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: Unsigned input -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_sig_unsigned"
                        android:layout_marginEnd="10dp" android:layout_marginTop="2dp"
                        android:contentDescription="Unsigned" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Input APK is unsigned"
                            android:textColor="@color/text_primary" android:textSize="13sp"
                            android:textStyle="bold" android:layout_marginBottom="3dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No cert is found in the input — the cert stamp is left empty and the check is silently skipped at runtime. No crash, no error. You can still sign the output later with any key."
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: Toggle ON -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_border"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_sig_warning"
                        android:layout_marginEnd="10dp" android:layout_marginTop="2dp"
                        android:contentDescription="Warning" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-Sign ON (built-in key)"
                            android:textColor="@color/text_primary" android:textSize="13sp"
                            android:textStyle="bold" android:layout_marginBottom="3dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="The output is signed with Ultra Dex2C-VMP's built-in key and the cert check is stamped to match. This works but will break your app's update chain — any future update you push must also be signed with the same built-in key. Only use this for apps you will never push to a store or update."
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
